# Cutiepii Robot Configuration
# Copy this file to .env and fill in your values

# ======================
# Bot Configuration
# ======================
TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id

# ======================
# Database Configuration
# ======================
# PostgreSQL connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/cutiepii_db

# Or individual components
DB_USER=cutiepii
DB_PASSWORD=changeme_strong_password
DB_NAME=cutiepii_db
DB_HOST=localhost
DB_PORT=5432

# ======================
# Redis Configuration
# ======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ======================
# MongoDB Configuration (Optional)
# ======================
# MongoDB is optional - bot works without it
# Only needed for legacy modules that use MongoDB
# MONGO_DB_URL=mongodb://user:pass@host:port/dbname
# Or for MongoDB Atlas:
# MONGO_DB_URL=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# ======================
# Telegram API (Optional)
# ======================
# Get from https://my.telegram.org
API_ID=
API_HASH=

# ======================
# Bot Settings
# ======================
# Number of worker threads (default: 8)
WORKERS=8

# Allow ! in addition to / for commands
ALLOW_EXCL=True

# Environment (True for production)
ENV=True

# ======================
# Logging
# ======================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ======================
# Optional API Keys
# ======================
# Weather API
OPENWEATHERMAP_ID=

# ARQ API
ARQ_API_URL=
ARQ_API_KEY=

# ImgBB (image hosting for /tgm)
IMGBB_API_KEY=

# ======================
# Admin Users (JSON format)
# ======================
# Add user IDs to elevated_users.json file instead
# DEV_USERS=[123456789]
# SUDO_USERS=[123456789]
# SUPPORT_USERS=[123456789]
# WHITELIST_USERS=[123456789]

# ======================
# Chat Settings
# ======================
# Support chat username (without @)
SUPPORT_CHAT=

# Bot username (without @)
BOT_USERNAME=

# Allow bot to join any chat
ALLOW_CHATS=True
